{
    "name": "vite_react_shadcn_ts",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "clean:dist": "node scripts/clean-dist.mjs",
        "prebuild": "npm run clean:dist",
        "build": "vite build",
        "prestart": "npm run build",
        "start": "vite preview --host --port 8080",
        "prebuild:dev": "npm run clean:dist",
        "build:dev": "vite build --mode development",
        "lint": "eslint .",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "playwright test",
        "preview": "vite preview",
        "android:copy": "npm --prefix apps/android run cap:copy",
        "android:sync:web": "npm --prefix apps/android run sync:web",
        "android:sync:native": "npm --prefix apps/android run cap:sync",
        "android:sync": "npm --prefix apps/android run sync:web && npm --prefix apps/android run cap:sync",
        "android:open": "npm --prefix apps/android run cap:open",
        "report:levels": "node scripts/level-build-report.mjs",
        "report:solutions": "node scripts/level-solution-report.mjs",
        "report:qa": "node scripts/level-qa-report.mjs",
        "seed:hint": "node -e \"console.log('In the app console: const seed = exportLocalStorageSeed(); copy(JSON.stringify(seed,null,2))  -> save as solver-seed.json to make report:solutions match your overrides.')\"",
        "ws:server": "node server/ws-server.mjs",
        "asset-writer": "node --env-file=.env server/asset-writer.mjs",
        "dev:all": "concurrently -k -n \"front,ws\" -c \"cyan,magenta\" \"npm run dev\" \"npm run ws:server\"",
        "db:seed": "node --env-file=.env scripts/seed-levels-to-db.mjs",
        "asset-writer:dev": "node --env-file=.env server/asset-writer.mjs"
    },
    "dependencies": {
